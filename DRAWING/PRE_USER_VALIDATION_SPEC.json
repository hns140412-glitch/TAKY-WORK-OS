{
  "schema_version": "2026-09-23.1",
  "principle": "HUMAN IS THE KEY != HUMAN IS THE DEBUGGER",
  "exposure_rule": "NO PASS -> NO SHOW",
  "gates": [
    {
      "id": "SOURCE_GATE",
      "blocks": [
        "wrong source crop",
        "source identity drift",
        "date-only freshness decision"
      ],
      "evidence": [
        "source_id",
        "content_digest",
        "revision_relation"
      ]
    },
    {
      "id": "GEOMETRY_GATE",
      "blocks": [
        "wall deletion",
        "core deletion",
        "entry deletion",
        "room/geometry regeneration",
        "wrong rotation"
      ],
      "evidence": [
        "geometry_diff",
        "edge_diff",
        "protected_anchor_diff"
      ]
    },
    {
      "id": "FACT_GATE",
      "blocks": [
        "unsupported numeric facts",
        "reference-only promotion"
      ],
      "evidence": [
        "fact evidence state",
        "source refs"
      ]
    },
    {
      "id": "SEMANTIC_GATE",
      "blocks": [
        "ROAD/SOIL/GROUND inference without verification",
        "invented landscape",
        "wrong furniture semantic role"
      ],
      "evidence": [
        "verified semantic map",
        "UNKNOWN preservation"
      ]
    },
    {
      "id": "REFERENCE_EFFECT_GATE",
      "blocks": [
        "generic layout",
        "reference named but not compiled",
        "clarity-only change mislabeled as reference effect"
      ],
      "evidence": [
        "reference compiler trace",
        "observable token delta"
      ]
    },
    {
      "id": "ARCHITECTURAL_READABILITY_GATE",
      "blocks": [
        "weak line hierarchy",
        "core/circulation unreadable",
        "entourage obscures architecture"
      ],
      "evidence": [
        "protected anchor visibility",
        "line hierarchy checks"
      ]
    },
    {
      "id": "A3_GATE",
      "blocks": [
        "cropping",
        "illegible print scale",
        "hero/support competition"
      ],
      "evidence": [
        "media box",
        "print-scale inspection",
        "layout hierarchy"
      ]
    },
    {
      "id": "USER_EFFECT_GATE",
      "blocks": [
        "result needs explanation to appear improved",
        "generic report family",
        "decision value absent"
      ],
      "evidence": [
        "before/after delta",
        "decision-value checks",
        "professional-family comparison"
      ]
    }
  ],
  "human_approval_boundary": {
    "allowed": [
      "final design choice",
      "presentation preference",
      "explicit geometry change",
      "trade-off selection"
    ],
    "forbidden": [
      "finding missing walls",
      "finding missing core",
      "finding crop errors",
      "finding semantic guesses",
      "finding unsupported narrative",
      "finding missing reference effect"
    ]
  }
}