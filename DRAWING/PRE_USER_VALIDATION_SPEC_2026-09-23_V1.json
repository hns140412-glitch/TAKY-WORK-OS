{
  "version": "2026-09-23.1",
  "policy": "NO PASS -> NO SHOW",
  "required_gates": [
    "SOURCE_GATE",
    "GEOMETRY_GATE",
    "FACT_GATE",
    "SEMANTIC_GATE",
    "REFERENCE_EFFECT_GATE",
    "ARCHITECTURAL_READABILITY_GATE",
    "A3_GATE",
    "USER_EFFECT_GATE"
  ],
  "auto_catch_before_user": [
    "wall deletion",
    "core deletion",
    "entry deletion",
    "wrong furniture box",
    "wrong rotation",
    "source crop error",
    "reference effect absent",
    "generic report layout",
    "invented semantics",
    "unsupported narrative",
    "engine bypass"
  ],
  "human_approval_role": "Final design/expression choice only; never primary defect detection.",
  "protected_geometry": [
    "wall",
    "core",
    "entry",
    "site boundary when applicable"
  ],
  "narrative_rule": "Claim strength <= evidence strength",
  "semantic_rule": "UNKNOWN remains UNKNOWN until verified",
  "exposure_rule": "Any required gate not PASS => BLOCKED"
}